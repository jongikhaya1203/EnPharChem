# EnPharChem deployment configuration
# Copy to .env and adjust. Used by docker-compose.yml (on-prem) and
# docker-compose.cloud.yml (cloud / managed DB).

# ── Public URL (keep the /enpharchem base path) ──
APP_URL=http://localhost:8080/enpharchem

# ── Database ──
# On-prem: leave DB_HOST=db (the bundled MariaDB service).
# Cloud:   point to your managed MySQL/MariaDB endpoint.
DB_HOST=db
DB_PORT=3306
DB_NAME=enpharchem
DB_USER=enpharchem
DB_PASS=change-me
# Only used by the bundled on-prem db service:
DB_ROOT_PASS=change-me-too

# ── Licensing ──
# Master switch for compute-time license gating (Flowsheet Simulator run()).
# Set to false for an unrestricted internal/eval build.
FLOWSHEET_LICENSE_ENFORCE=true

# Air-gapped on-prem only: path to a vendor-signed offline license file and the
# public key that verifies it. Leave unset when using the online portal.
# LICENSE_FILE=/var/lib/enpharchem/license.lic
# LICENSE_PUBKEY=/var/www/html/enpharchem/deploy/keys/vendor_public.pem
