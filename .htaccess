RewriteEngine On
RewriteBase /enpharchem/

# Block direct browser access to application internals. Every request is meant
# to arrive through index.php, which is where authentication, authorisation and
# the CSRF check live. These are real files on disk, so the front-controller
# rule below (which only fires for paths that do NOT exist) would not catch
# them: a direct POST to a view or controller would bypass every check.
RewriteRule ^(controllers|models|views|lib|config|database|deploy)/ - [F,L]

# Redirect to index.php if not a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Deny access to sensitive files
<FilesMatch "\.(sql|md|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct web access to maintenance / setup scripts. These have no place
# being reachable from a browser on a live install (reset_admin.php can create
# or reset an administrator without authentication). First-time setup runs from
# the CLI: `php install.php` with ENPHARCHEM_ALLOW_INSTALL=1.
<FilesMatch "^(reset_admin|test_db|setup_superuser|install)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>
