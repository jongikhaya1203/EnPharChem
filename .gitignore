# EnPharChem - Git Ignore
.claude/

# Deployment secrets - DEPLOYMENT.md promises these are never committed.
# The example template stays tracked; the real .env never is.
.env
.env.*
!.env.example
# Private signing keys, anywhere in the tree (deploy/keys has its own rules too)
*_private.pem
*.key

test_db.php
reset_admin.php
setup_superuser.php
database/create_settings.php
database/migrate_control_panel.php
*.log
*.tmp
.DS_Store
Thumbs.db

# Generated PDF caches - rebuilt on every request by MarketingDocsController
assets/pdfs/module-catalogue.pdf
assets/pdfs/how-to-manual.pdf
assets/pdfs/business-process-map.pdf
